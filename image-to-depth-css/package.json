{
  "name": "image-to-depth-css",
  "version": "1.0.0",
  "description": "Convert poster graphics and woodcut-style scans to CSS multi-layer parallax assets",
  "main": "dist/index.js",
  "bin": {
    "image-to-depth-css": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "parallax",
    "css",
    "image-processing",
    "depth-estimation",
    "poster",
    "woodcut",
    "layering"
