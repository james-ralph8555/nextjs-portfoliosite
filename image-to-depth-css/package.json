  "author": "",
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.33.0",
    "canvas": "^2.11.2",
    "opencv-ts": "^1.0.0",
    "quantize": "^1.0.2",
    "svg-path-tools": "^1.0.0",
    "commander": "^11.0.0",
    "chalk": "^4.1.2",
    "progress": "^2.0.3",
    "mkdirp": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sharp": "^0.32.0",
    "@types/quantize": "^1.0.2",
    "@types/progress": "^2.0.5",
    "@types/mkdirp": "^1.0.2",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}